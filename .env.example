# App Environment
MOOD=development
PORT=3000
APPLICATIION_NAME=POS-Backend

# MongoDB Database (Must be a Replica Set for MongoDB Transactions support)
DATABASE_URI=mongodb://localhost:27017/pos_db?replicaSet=rs0

# Redis Cache & Storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_URI=redis://localhost:6379
CACHE_TYPE=redis

# Admin Seeding (Used by npm run seed:admin)
ADMIN_EMAIL=admin@pos.com
ADMIN_PASSWORD=Admin@123456
ADMIN_PHONE=01012345678

# Security & Encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
ENCRYPTION_METHOD=aes-256-cbc
IV_LENGTH=16
SALT_ROUND=12

# JWT Authentication (Bearer User Tokens)
JWT_SECRET_BEARER_ACCESS=super_secret_access_jwt_key
JWT_BEARER_ACCESS_EXP=3600
JWT_SECRET_BEARER_REFRESH=super_secret_refresh_jwt_key
JWT_REFRESH_BEARER_EXP=604800

# JWT System Tokens (Internal Operations)
JWT_SECRET_SYSTEM_ACCESS=super_secret_system_access_jwt_key
JWT_ACCESS_SYSTEM_EXP=3600
JWT_SECRET_SYSTEM_REFRESH=super_secret_system_refresh_jwt_key
JWT_REFRESH_SYSTEM_EXP=604800

# Email Delivery (SMTP / Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary Media Storage
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
SUCCESS_URL=http://localhost:3000/api/v1/payments/success
CANCEL_URL=http://localhost:3000/api/v1/payments/cancel

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@appspot.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

